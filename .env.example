# PostgreSQL settings for local development only.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=simple_api
POSTGRES_PORT=5433

# Used by axum-server when it is exported into the shell environment.
DATABASE_URL=postgres://user:password@127.0.0.1:5433/simple_api
RUST_LOG=axum_server=debug,sqlx=info
